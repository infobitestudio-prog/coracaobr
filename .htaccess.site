# CoraçãoBR · regras da hospedagem (Apache/LiteSpeed, ex.: Hostinger)
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .js .css .json .txt .webmanifest
Options -Indexes
# O banco de dados nunca é servido pela web
RedirectMatch 404 /dados(/|$)
RedirectMatch 404 /api/vendor(/|$)

# Mapa do site e robots.txt com o endereço real do site (gerados pela API)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ api/index.php?acao=sitemap [L,QSA]
  RewriteRule ^robots\.txt$ api/index.php?acao=robots [L,QSA]
</IfModule>
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|log)$">
  Require all denied
</FilesMatch>
# Configuração da instalação (chave): só o PHP lê, pela web nunca
<FilesMatch "^config(\.exemplo)?\.php$">
  Require all denied
</FilesMatch>

# HTML, JS e CSS: o navegador confere se há versão nova a cada visita (resposta rápida 304 quando não mudou)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Site leve: compressão gzip do que é texto e cache longo para imagens e fontes
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
AddType image/webp .webp
AddType application/manifest+json .webmanifest

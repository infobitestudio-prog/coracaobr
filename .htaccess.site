# CoraçãoBR · regras da hospedagem (Apache/LiteSpeed, ex.: Hostinger)
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .js .css .json .txt .webmanifest
Options -Indexes
# O banco de dados nunca é servido pela web
RedirectMatch 404 /dados(/|$)
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|log)$">
  Require all denied
</FilesMatch>

# HTML, JS e CSS: o navegador confere se há versão nova a cada visita (resposta rápida 304 quando não mudou)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
